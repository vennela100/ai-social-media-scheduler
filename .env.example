# Copy this file to ".env" and fill in real values. .env is gitignored.
# In production, set these as Render env vars and GitHub repo Secrets instead.

# --- Django core ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins for CSRF, comma-separated, e.g. https://yourapp.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database (Neon Postgres) ---
# Leave blank to use local SQLite. Paste the Neon connection string to use Postgres.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Token encryption (Phase 3+) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Cloudinary (Phase 1: images + thumbnails) ---
CLOUDINARY_URL=

# --- Cloudflare R2 (large videos, direct browser upload) ---
# dash.cloudflare.com -> R2 -> create bucket -> Settings: enable public r2.dev URL
# -> Manage R2 API Tokens -> create token (Object Read & Write).
# Leave blank to keep all uploads on Cloudinary (100 MB video cap).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public base URL, e.g. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_BASE_URL=
# Our own per-video ceiling for direct uploads (default 2048 MB).
R2_VIDEO_MAX_MB=

# --- Gemini (Phase 2) ---
GEMINI_API_KEY=
# Skip Gemini media analysis for files over these caps (defaults: 512 MB / 300 s).
# Long videos cost real tokens — raise with care on the free Gemini tier.
MEDIA_ANALYSIS_MAX_BYTES=
MEDIA_ANALYSIS_MAX_SECONDS=

# --- YouTube / Google OAuth (Phase 3) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Instagram / Meta (Phase 5) ---
META_APP_ID=
META_APP_SECRET=

# --- LinkedIn (Phase 6) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Failure notifications (Phase 4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email notifications (SMTP) ---
# For Gmail: EMAIL_HOST_USER is your address; EMAIL_HOST_PASSWORD is a 16-char
# App Password from https://myaccount.google.com/apppasswords (2FA required).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Where alert emails are sent (defaults to EMAIL_HOST_USER if blank).
NOTIFY_EMAIL=
# Base URL for links in emails, e.g. https://yourapp.onrender.com
DASHBOARD_URL=http://localhost:8000
